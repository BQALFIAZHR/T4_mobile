<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FFF0F5">


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Catatan Tugas Fia"
        android:textAlignment="center"
        android:textColor="#D81B60"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:elevation="4dp">

        <EditText
            android:id="@+id/etJudul"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Judul Tugas"
            android:inputType="text"
            android:textColor="#000000"
            android:textColorHint="#FF80AB"
            android:backgroundTint="#E91E63" />

        <EditText
            android:id="@+id/etDeskripsi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Deskripsi Tugas"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:textColor="#000000"
            android:textColorHint="#FF80AB"
            android:backgroundTint="#E91E63" />

        <Button
            android:id="@+id/btnSimpan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Simpan Tugas"
            android:textColor="#FFFFFF"
            android:layout_marginTop="20dp"
            android:paddingVertical="12dp"
            app:backgroundTint="#D81B60"
            app:cornerRadius="12dp" />

        <Button
            android:id="@+id/btnBackup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Backup ke File TXT"
            android:textColor="#D81B60"
            android:layout_marginTop="8dp"
            android:paddingVertical="12dp"
            app:backgroundTint="#FFF0F5"
            app:cornerRadius="12dp"
            app:strokeColor="#D81B60"
            app:strokeWidth="2dp"/>

    </LinearLayout>


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Daftar Tugas:"
        android:textColor="#D81B60"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="12dp"
        android:paddingHorizontal="4dp"/>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="4dp" />

</LinearLayout>